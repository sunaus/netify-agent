#!/bin/sh
#
# netifyd        Starts the Netify Agent.
#

umask 077

source /usr/share/netifyd/functions.sh

NETIFY_OPTS=$(auto_detect_options)

start() {
	printf "Starting netifyd: "
	/usr/sbin/netifyd $NETIFY_OPTS
	if [ $? -eq 0 ]; then
		touch /var/lock/netifyd
		echo "OK"
		exit 0
	else
		echo "FAIL"
		exit 1
	fi
}

stop() {
	printf "Stopping netifyd: "
	if [ -e "/var/run/netifyd/netifyd.pid" ]; then
		killall netifyd
		killall netifyd
		rm -f /var/lock/netifyd
		echo "OK"
		exit 0
	else
		echo "FAIL"
		exit 1
	fi
}

reload() {
	killall -HUP netifyd
}

restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  reload)
	reload
	;;
  restart)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|reload|restart}"
	exit 1
esac

exit $?

