[Unit]
Description=@PACKAGE_NAME@
After=syslog.target network-online.target
Documentation=man:netifyd(8) man:netifyd.conf(5)
Documentation=https://netify.ai/

[Service]
Type=forking
User=root
#User=netify
#Group=netify
EnvironmentFile=@volatilestatedir@/systemd.env
ExecStartPre=@datadir@/@PACKAGE_TARNAME@/exec-pre.sh
ExecStart=@sbindir@/@PACKAGE_TARNAME@ $NETIFYD_OPTS
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
#NetworkNamespacePath=/var/run/netns/gw-ubuntu0
#AmbientCapabilities=CAP_NET_ADMIN,CAP_NET_RAW

[Install]
WantedBy=multi-user.target
