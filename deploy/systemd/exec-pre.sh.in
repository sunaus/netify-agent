set -eo pipefail

. @datadir@/@PACKAGE_TARNAME@/functions.sh

load_modules

NETIFYD_OPTS=$(auto_detect_options)

echo "# Auto-generated by: $0" > @volatilestatedir@/systemd.env
cat @datadir@/@PACKAGE_TARNAME@/systemd.env >> @volatilestatedir@/systemd.env
echo "NETIFYD_OPTS=\"$NETIFYD_OPTS\"" >> @volatilestatedir@/systemd.env

exit 0

